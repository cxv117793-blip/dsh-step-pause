{
  "name": "dsh-step-pause",
  "version": "0.4.9",
  "description": "每 N 步自动停下汇报一次进度（正在做什么 / 已完成什么 / 接下来做什么 / 卡点），说完立刻继续，不占额外回合、不等你回复。(DeepSeek Harness plugin: periodic in-chat progress checkpoints that never block the turn.)",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs/config-page.png",
    "docs/measurements.png",
    "docs/cost.md",
    "docs/auto-resume.md",
    "docs/overhead-vs-n.svg",
    "docs/promo/poster.png",
    "docs/promo/contact-sheet.png",
    "docs/promo/x-card-before-after.png",
    "docs/promo/x-card-mechanism.png",
    "docs/promo/x-post.md",
    "tools",
    "test/index.test.mjs",
    "test/client.test.mjs",
    "test/verify-client-mutations.mjs",
    "test/verify-subagent-real.mjs",
    "test/verify-autoresume-real.mjs"
  ],
  "scripts": {
    "test": "node test/index.test.mjs && node test/client.test.mjs",
    "test:mutations": "node test/verify-client-mutations.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "agent",
    "agent-framework",
    "progress",
    "progress-report",
    "checkpoint",
    "step",
    "long-running-tasks",
    "llm"
  ],
  "license": "MIT",
  "author": "cxv117793-blip",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cxv117793-blip/dsh-step-pause.git"
  },
  "homepage": "https://github.com/cxv117793-blip/dsh-step-pause#readme",
  "bugs": {
    "url": "https://github.com/cxv117793-blip/dsh-step-pause/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible"
      }
    }
  }
}
